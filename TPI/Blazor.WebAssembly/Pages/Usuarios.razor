@page "/usuarios"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Usuarios</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Usuarios</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (esAdmin)
            {
                <div class="mb-3">
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Rol</th>
                                <th>Fecha Alta</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (usuarios != null && usuarios.Any())
                            {
                                @foreach (var usuario in usuarios)
                                {
                                    <tr>
                                        <td>@usuario.Id</td>
                                        <td>@usuario.Nombre</td>
                                        <td>@usuario.Apellido</td>
                                        <td>@usuario.Email</td>
                                        <td>@usuario.Telefono</td>
                                        <td>@usuario.Rol</td>
                                        <td>@usuario.FechaAlta.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>
                                            @if (esAdmin)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(usuario)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(usuario)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<UsuarioModal @ref="usuarioModal" OnUsuarioChanged="LoadUsuarios" />

@code {
    private List<UsuarioDTO>? usuarios;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private UsuarioModal usuarioModal = null!;
    private bool esAdmin = AuthService.IsAdmin;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadUsuarios();
    }

    private async Task LoadUsuarios()
    {
        try
        {
            loading = true;
            usuarios = (await UsuarioApiClient.GetAllAsync())?.ToList();
            successMessage = string.Empty; // Clear success message when reloading
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar usuarios: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenAddModal()
    {
        usuarioModal.ShowAddModal();
    }

    private void OpenEditModal(UsuarioDTO usuario)
    {
        usuarioModal.ShowEditModal(usuario);
    }

    private async Task ConfirmDelete(UsuarioDTO usuario)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el usuario {usuario.Nombre} {usuario.Apellido}?");

        if (confirm)
        {
            await DeleteUsuario(usuario.Id);
        }
    }

    private async Task DeleteUsuario(int id)
    {
        try
        {
            if (await UsuarioApiClient.DeleteAsync(id))
                successMessage = "Usuario eliminado.";
            else
                errorMessage = "No se pudo eliminar el usuario.";
            await LoadUsuarios();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar usuario: {ex.Message}";
        }
    }
}
