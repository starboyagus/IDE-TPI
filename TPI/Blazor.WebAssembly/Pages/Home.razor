@page "/"
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

@if (isAuthenticated)
{
    <h2>Bienvenido @username!</h2>
    
        <h3>Informe de ventas</h3>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
            </div>
        }

        <div class="row align-items-end mb-3">
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" @bind="desde" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="hasta" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select class="form-select" @bind="estadoSeleccionado">
                    <option value="0">Todos (sin cancelados)</option>
                    @foreach (var estado in Enum.GetValues<EstadoOrden>())
                    {
                        <option value="@((int)estado)">@estado</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Top productos</label>
                <input type="number" min="1" max="100" class="form-control" @bind="top" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary flex-fill" @onclick="VerInforme" disabled="@loading">Ver informe</button>
                <button class="btn btn-outline-dark flex-fill" @onclick="DescargarPdf" disabled="@descargando">
                    @if (descargando)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    Descargar PDF
                </button>
            </div>
        </div>

        @if (loading)
        {
            <div class="d-flex justify-content-center">
                <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
            </div>
        }
        else if (informe != null)
        {
            <div class="row mb-4">
                <div class="col-md-4"><div class="card card-body"><small>Órdenes</small><h4>@informe.Resumen.CantidadOrdenes</h4></div></div>
                <div class="col-md-4"><div class="card card-body"><small>Total facturado</small><h4>$ @informe.Resumen.TotalFacturado.ToString("N2")</h4></div></div>
                <div class="col-md-4"><div class="card card-body"><small>Ticket promedio</small><h4>$ @informe.Resumen.TicketPromedio.ToString("N2")</h4></div></div>
            </div>

            <h5>Ventas por mes</h5>
            @if (graficos?.VentasPorMes != null)
            {
                <img class="img-fluid mb-2 mx-auto d-block" src="data:image/png;base64,@graficos.VentasPorMes" alt="Facturación por mes" />
            }
            <table class="table table-sm table-striped mb-4">
                <thead class="table-dark"><tr><th>Mes</th><th class="text-end">Órdenes</th><th class="text-end">Facturación</th><th class="text-end">Ticket promedio</th></tr></thead>
                <tbody>
                    @foreach (var d in informe.VentasPorMes)
                    {
                        <tr><td>@d.Periodo</td><td class="text-end">@d.CantidadOrdenes</td><td class="text-end">$ @d.TotalFacturado.ToString("N2")</td><td class="text-end">$ @d.TicketPromedio.ToString("N2")</td></tr>
                    }
                </tbody>
            </table>

            <h5>Productos más vendidos</h5>
            @if (graficos?.TopProductos != null)
            {
                <img class="img-fluid mb-2 mx-auto d-block" src="data:image/png;base64,@graficos.TopProductos" alt="Productos más vendidos" />
            }
            <table class="table table-sm table-striped mb-4">
                <thead class="table-dark"><tr><th>Producto</th><th>Categoría</th><th>Marca</th><th class="text-end">Unidades</th><th class="text-end">Facturación</th></tr></thead>
                <tbody>
                    @foreach (var d in informe.TopProductos)
                    {
                        <tr><td>@d.Producto</td><td>@d.Categoria</td><td>@d.Marca</td><td class="text-end">@d.UnidadesVendidas</td><td class="text-end">$ @d.Facturacion.ToString("N2")</td></tr>
                    }
                </tbody>
            </table>

            <h5>Facturación por marca</h5>
            @if (graficos?.FacturacionPorMarca != null)
            {
                <img class="img-fluid mb-2 mx-auto d-block" src="data:image/png;base64,@graficos.FacturacionPorMarca" alt="Facturación por marca" />
            }
            <table class="table table-sm table-striped">
                <thead class="table-dark"><tr><th>Marca</th><th class="text-end">Unidades</th><th class="text-end">Facturación</th><th class="text-end">%</th></tr></thead>
                <tbody>
                    @foreach (var d in informe.FacturacionPorMarca)
                    {
                        <tr><td>@d.Marca</td><td class="text-end">@d.UnidadesVendidas</td><td class="text-end">$ @d.Facturacion.ToString("N2")</td><td class="text-end">@d.Porcentaje.ToString("N2") %</td></tr>
                    }
                </tbody>
            </table>

        }
    
}

@code {
    private GraficosInformeDTO? graficos;
    private bool isAuthenticated = false;
    private string username = "";
    private DateTime desde = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime hasta = DateTime.Today;
    private int estadoSeleccionado = 0;
    private int top = 10;
    private InformeVentasDTO? informe;
    private bool loading = false;
    private bool descargando = false;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        isAuthenticated = AuthService.IsAuthenticated;
        username = isAuthenticated ? AuthService.UsuarioActual?.Nombre ?? "" : "";

        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/productos-user");
            return;
        }
    }

    private EstadoOrden? Estado => estadoSeleccionado == 0 ? null : (EstadoOrden)estadoSeleccionado;

    private bool ValidarFiltros()
    {
        errorMessage = string.Empty;

        if (desde.Date > hasta.Date)
        {
            errorMessage = "La fecha desde no puede ser posterior a la fecha hasta.";
            return false;
        }

        if (top < 1 || top > 100)
        {
            errorMessage = "El top debe estar entre 1 y 100.";
            return false;
        }

        return true;
    }

    private async Task VerInforme()
    {
        if (!ValidarFiltros())
            return;

        try
        {
            loading = true;
            informe = null;
            graficos = null;

            var tareaInforme = ReporteApiClient.GetInformeVentasAsync(desde, hasta, Estado, top);
            var tareaGraficos = ReporteApiClient.GetGraficosInformeAsync(desde, hasta, Estado, top);

            informe = await tareaInforme;
            graficos = await tareaGraficos;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al generar el informe: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }



    private async Task DescargarPdf()
    {
        if (!ValidarFiltros())
            return;

        try
        {
            descargando = true;
            var pdf = await ReporteApiClient.GetInformeVentasPdfAsync(desde, hasta, Estado, top);
            await JSRuntime.InvokeVoidAsync("descargarArchivo",
                $"informe-ventas-{desde:yyyyMMdd}-{hasta:yyyyMMdd}.pdf",
                Convert.ToBase64String(pdf));
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al descargar el PDF: {ex.Message}";
        }
        finally
        {
            descargando = false;
        }
    }
}
