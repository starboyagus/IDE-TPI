@page "/marcas"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Marcas</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Marcas</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (esAdmin)
            {
                <div class="mb-3">
                    <button class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>País de Origen</th>
                                <th>Fecha Alta</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (marcas != null && marcas.Any())
                            {
                                @foreach (var marca in marcas)
                                {
                                    <tr>
                                        <td>@marca.Id</td>
                                        <td>@marca.Nombre</td>
                                        <td>@marca.PaisOrigen</td>
                                        <td>@marca.FechaAlta.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>
                                            @if (esAdmin)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(marca)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(marca)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<MarcaModal @ref="marcaModal" OnMarcaChanged="LoadMarcas" />

@code {
    private List<MarcaDTO>? marcas;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private MarcaModal marcaModal = null!;
    private bool esAdmin = AuthService.IsAdmin;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadMarcas();
    }

    private async Task LoadMarcas()
    {
        try
        {
            loading = true;
            marcas = (await MarcaApiClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar marcas: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenAddModal()
    {
        marcaModal.ShowAddModal();
    }

    private void OpenEditModal(MarcaDTO marca)
    {
        marcaModal.ShowEditModal(marca);
    }

    private async Task ConfirmDelete(MarcaDTO marca)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar la marca {marca.Nombre}?");

        if (confirm)
        {
            await DeleteMarca(marca.Id);
        }
    }

    private async Task DeleteMarca(int id)
    {
        try
        {
            if (await MarcaApiClient.DeleteAsync(id))
                successMessage = "Marca eliminada.";
            else
                errorMessage = "No se pudo eliminar la marca.";
            await LoadMarcas();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar marca: {ex.Message}";
        }
    }
}
