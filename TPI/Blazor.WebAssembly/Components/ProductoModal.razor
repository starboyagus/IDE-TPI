@inject IJSRuntime JSRuntime
@using System.Text.Json

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (mode == FormMode.Add)
                        {
                            <text>Agregar</text>
                        }
                        else
                        {
                            <text>Editar</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentProducto" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />


                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText @bind-Value="currentProducto.Nombre" class="form-control" />
                            @if (validationErrors.ContainsKey("Nombre"))
                            {
                                <div class="text-danger small">@validationErrors["Nombre"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción *</label>
                            <InputText @bind-Value="currentProducto.Descripcion" class="form-control" />
                            @if (validationErrors.ContainsKey("Descripcion"))
                            {
                                <div class="text-danger small">@validationErrors["Descripcion"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Precio *</label>
                            <InputNumber @bind-Value="currentProducto.Precio" class="form-control" />
                            @if (validationErrors.ContainsKey("Precio"))
                            {
                                <div class="text-danger small">@validationErrors["Precio"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Stock *</label>
                            <InputNumber @bind-Value="currentProducto.Stock" class="form-control" />
                            @if (validationErrors.ContainsKey("Stock"))
                            {
                                <div class="text-danger small">@validationErrors["Stock"]</div>
                            }
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="currentProducto.EsPreVenta" class="form-check-input" id="esPreVenta" />
                            <label class="form-check-label" for="esPreVenta">Es pre-venta</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Categoría *</label>
                            <InputSelect @bind-Value="currentProducto.CategoriaId" class="form-select">
                                <option value="0">-- Seleccioná una categoría --</option>
                                @foreach (var categoria in categorias)
                                {
                                    <option value="@categoria.Id">@categoria.Nombre</option>
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("CategoriaId"))
                            {
                                <div class="text-danger small">@validationErrors["CategoriaId"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Marca *</label>
                            <InputSelect @bind-Value="currentProducto.MarcaId" class="form-select">
                                <option value="0">-- Seleccioná una marca --</option>
                                @foreach (var marca in marcas)
                                {
                                    <option value="@marca.Id">@marca.Nombre</option>
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("MarcaId"))
                            {
                                <div class="text-danger small">@validationErrors["MarcaId"]</div>
                            }
                        </div>


                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Fecha Alta</label>
                                <input type="text" class="form-control" value="@currentProducto.FechaAlta.ToString("dd/MM/yyyy HH:mm")" readonly />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(mode == FormMode.Add ? "Agregar" : "Actualizar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnProductoChanged { get; set; }

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private ProductoDTO currentProducto = new ProductoDTO();
    private List<CategoriaDTO> categorias = new List<CategoriaDTO>();
    private List<MarcaDTO> marcas = new List<MarcaDTO>();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();

    public enum FormMode
    {
        Add,
        Update
    }

    public async Task ShowAddModal()
    {
        mode = FormMode.Add;
        currentProducto = new ProductoDTO();
        ClearValidationErrors();
        await CargarCombosAsync();
        showModal = true;
        StateHasChanged();
    }

    public async Task ShowEditModal(ProductoDTO producto)
    {
        mode = FormMode.Update;
        currentProducto = new ProductoDTO
        {
            Id = producto.Id,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            Precio = producto.Precio,
            Stock = producto.Stock,
            EsPreVenta = producto.EsPreVenta,
            CategoriaId = producto.CategoriaId,
            MarcaId = producto.MarcaId,
            FechaAlta = producto.FechaAlta,
            EsActivo = producto.EsActivo
        };
        ClearValidationErrors();
        await CargarCombosAsync();

        if (!categorias.Any(c => c.Id == currentProducto.CategoriaId))
            currentProducto.CategoriaId = 0;

        if (!marcas.Any(m => m.Id == currentProducto.MarcaId))
            currentProducto.MarcaId = 0;

        showModal = true;
        StateHasChanged();
    }

    private async Task CargarCombosAsync()
    {
        try
        {
            categorias = await CategoriaApiClient.GetAllAsync();
            marcas = await MarcaApiClient.GetAllAsync() ?? new List<MarcaDTO>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar categorías y marcas: {ex.Message}";
        }
    }

    private static async Task<string> ExtraerMensajeError(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<JsonElement>();
            if (body.ValueKind == JsonValueKind.Object && body.TryGetProperty("error", out var errorProp))
            {
                return errorProp.GetString() ?? "Ocurrió un error al guardar el producto.";
            }
        }
        catch
        {
        }

        return $"Ocurrió un error al guardar el producto ({(int)response.StatusCode} {response.ReasonPhrase}).";
    }

    private async Task HandleValidSubmit()
    {
        if (!ValidateProducto())
            return;

        try
        {
            saving = true; errorMessage = string.Empty;
            var response = mode == FormMode.Add
                ? await ProductoApiClient.AddAsync(currentProducto)
                : await ProductoApiClient.UpdateAsync(currentProducto);

            if (response == null || !response.IsSuccessStatusCode)
            {
                errorMessage = response != null ? await ExtraerMensajeError(response) : "No se obtuvo respuesta del servidor.";
                return;
            }

            await OnProductoChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool ValidateProducto()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(currentProducto.Nombre))
        {
            validationErrors["Nombre"] = "El Nombre es requerido";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentProducto.Descripcion))
        {
            validationErrors["Descripcion"] = "La Descripción es requerida";
            isValid = false;
        }

        if (currentProducto.Precio < 0)
        {
            validationErrors["Precio"] = "El Precio no puede ser negativo";
            isValid = false;
        }

        if (currentProducto.Stock < 0)
        {
            validationErrors["Stock"] = "El Stock no puede ser negativo";
            isValid = false;
        }

        if (currentProducto.CategoriaId <= 0)
        {
            validationErrors["CategoriaId"] = "La Categoría es requerida";
            isValid = false;
        }

        if (currentProducto.MarcaId <= 0)
        {
            validationErrors["MarcaId"] = "La Marca es requerida";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}
