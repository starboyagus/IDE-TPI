@implements IDisposable

<div class="top-row ps-3 navbar bg-black navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">
            <img src="/icon-192.png" alt="" width="30" height="30" class="d-inline-block align-text-center">
            IDEware
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable bg-dark" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link p-2 rounded-3" href="" Match="NavLinkMatch.All">
                <span class="fas fa-house me-2" aria-hidden="true"></span> Home
            </NavLink>
            @if (AuthService.IsAuthenticated)
            {
                @if (AuthService.IsAdmin)
                {
                    <NavLink class="nav-link p-2 rounded-3" href="productos" Match="NavLinkMatch.All">
                        <span class="fas fa-arrow-right me-2" aria-hidden="true"></span> Productos
                    </NavLink>
                }
                else
                {
                    <NavLink class="nav-link p-2 rounded-3" href="productos-user" Match="NavLinkMatch.All">
                        <span class="fas fa-arrow-right me-2" aria-hidden="true"></span> Productos
                    </NavLink>
                }

                @if (AuthService.IsAdmin)
                {
                    <NavLink class="nav-link p-2 rounded-3" href="ordenes" Match="NavLinkMatch.All">
                        <span class="fas fa-arrow-right me-2" aria-hidden="true"></span> Órdenes
                    </NavLink>
                }
                else
                {
                    <NavLink class="nav-link p-2 rounded-3" href="mis-ordenes" Match="NavLinkMatch.All">
                        <span class="fas fa-box-open me-2" aria-hidden="true"></span> Mis Órdenes
                    </NavLink>
                }
            }
            @if (AuthService.IsAdmin)
            {
                <NavLink class="nav-link p-2 rounded-3" href="usuarios" Match="NavLinkMatch.All">
                    <span class="fas fa-arrow-right me-2" aria-hidden="true"></span> Usuarios
                </NavLink>
                <NavLink class="nav-link p-2 rounded-3" href="categorias" Match="NavLinkMatch.All">
                    <span class="fas fa-arrow-right me-2" aria-hidden="true"></span> Categorias
                </NavLink>
                <NavLink class="nav-link p-2 rounded-3" href="marcas" Match="NavLinkMatch.All">
                    <span class="fas fa-arrow-right me-2" aria-hidden="true"></span> Marcas
                </NavLink>
            }
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        AuthService.SesionCambio += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.SesionCambio -= StateHasChanged;
    }
}
