@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end">
            @if (AuthService.IsAuthenticated)
            {
                <span class="me-1">@AuthService.UsuarioActual!.Nombre</span>
                @if (!AuthService.IsUser)
                {
                    <button class="btn btn-sm me-3 btn-warning fw-bold pe-none">@AuthService.UsuarioActual!.Rol</button>
                }
                else
                {
                    <button class="btn btn-sm me-3 btn-success fw-bold pe-none">@AuthService.UsuarioActual!.Rol</button>

                }
                
                <button class="btn btn-danger btn-sm" @onclick="Logout">Cerrar Sesión</button>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.SesionCambio += StateHasChanged;
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthService.SesionCambio -= StateHasChanged;
    }
}